      "root-filesystem": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Root Filesystem Usage",
          "description": "Root filesystem utilization for monitored hosts.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"})",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
