      "container-cpu": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Top Containers by CPU",
          "description": "Top ten Docker containers by current CPU utilization.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\",name!=\"/\",id=~\"/docker/.*\"}[$__rate_interval])) * 100)",
                        "legendFormat": "{{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 10,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": true
                  },
                  "mappings": [],
                  "unit": "percent"
                },
                "overrides": []
              }
            }
          }
        }
