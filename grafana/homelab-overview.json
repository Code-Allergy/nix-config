{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "homelab-overview"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "healthy-targets": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Healthy Scrape Targets",
          "description": "Prometheus targets reporting healthy.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(up)",
                        "legendFormat": "healthy targets",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "textMode": "value_and_name"
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "red" },
                      { "color": "green", "value": 1 }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "down-targets": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Unhealthy Scrape Targets",
          "description": "Prometheus targets not reporting healthy.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(up) - sum(up)",
                        "legendFormat": "down targets",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "textMode": "value_and_name"
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "green" },
                      { "color": "red", "value": 1 }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "peak-cpu": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Peak Host CPU",
          "description": "Highest current CPU utilization across monitored hosts.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "max(100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))))",
                        "legendFormat": "max host CPU",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "textMode": "value_and_name"
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "green" },
                      { "color": "orange", "value": 70 },
                      { "color": "red", "value": 90 }
                    ]
                  },
                  "unit": "percent"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "peak-memory": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Peak Host Memory",
          "description": "Highest current memory utilization across monitored hosts.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "max(100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)))",
                        "legendFormat": "max host memory",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "textMode": "value_and_name"
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "green" },
                      { "color": "orange", "value": 70 },
                      { "color": "red", "value": 90 }
                    ]
                  },
                  "unit": "percent"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "host-cpu": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Host CPU Usage",
          "description": "CPU utilization for tower, optimus, and ampere.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dfxzi2v4vvchsa"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
                        "legendFormat": "{{instance}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "calcs": ["lastNotNull", "max"],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 12,
                    "lineInterpolation": "smooth",
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": true
                  },
                  "mappings": [],
                  "unit": "percent"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "host-memory": {
        "kind": "Panel",
        "spec": {
