      "log-volume": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Log Volume by Service",
          "description": "Loki log lines per interval grouped by service.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "ffxzi6kfzagaod"
                      },
                      "spec": {
                        "expr": "sum by (service_name) (count_over_time({environment=\"homelab\"}[$__interval]))",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
